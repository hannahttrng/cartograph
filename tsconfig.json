{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2020"
  },
  "include": [
    "index.ts",
    "frontend/App.tsx",
    "frontend/src/**/*.ts",
    "frontend/src/**/*.tsx"
  ],
  "extends": "expo/tsconfig.base"
}
