# Frontend: false enables live Carter chat/recipe calls; other demo data remains local.
EXPO_PUBLIC_USE_MOCK_DATA=false

# iOS Simulator. Replace localhost with the development Mac's LAN IP on a physical device.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Backend-only Carter configuration. Never expose the key through an EXPO_PUBLIC_ variable.
CARTER_API_URL=https://gateway.example.com/complete/inference/path
AZURE_OPENAI_API_KEY=
CARTER_API_MODE=chat-completions

# Optional ArcGIS web map overrides.
EXPO_PUBLIC_ARCGIS_WEB_MAP_ITEM_ID=1114223c46f948c4b17a6ddb8c3e4865
EXPO_PUBLIC_ARCGIS_PORTAL_URL=https://intern-hackathon.maps.arcgis.com